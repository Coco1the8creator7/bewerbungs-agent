[Unit]
Description=Career.Agency email outbox
After=postgresql.service
OnFailure=careeragency-ops-alert@%n.service

[Service]
Type=oneshot
User=careeragency_auth
Group=careeragency_auth
WorkingDirectory=/opt/careeragency/auth-current
EnvironmentFile=/etc/careeragency/auth.env
ExecStart=/opt/careeragency/auth-current/.venv/bin/python -m authservice.outbox
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
