#!/usr/bin/env bash
# Root-owned, forced-command SSH entry point.
# The SSH account MUST have no sudo rights and no production write access.
set -euo pipefail
export PATH=/usr/bin:/bin
export GIT_TERMINAL_PROMPT=0
umask 077

case "${SSH_ORIGINAL_COMMAND:-}" in
  status)
    echo "careeragency_operations=connected"
    echo "time_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if systemctl is-active --quiet caddy; then
      echo "caddy=active"
    else
      echo "caddy=not_active"
    fi
    if [[ -f /var/www/careeragency/current/index.html ]]; then
      echo "landing_file=present"
    else
      echo "landing_file=missing"
    fi
    if [[ -s /srv/careeragency-landing-feed/jobs.json ]]; then
      echo "yousty_feed_file=present"
    else
      echo "yousty_feed_file=missing"
    fi
    ;;
  tests)
    # Isolated, disposable clone. Never execute test code as root or ubuntu.
    workdir="$(mktemp -d /tmp/careeragency-ops-tests.XXXXXXXX)"
    trap 'rm -rf -- "$workdir"' EXIT
    timeout 90s git clone --quiet --depth 1 \
      --branch poc/lehrstellen-crawler-isolated \
      https://github.com/Coco1the8creator7/bewerbungs-agent.git \
      "$workdir/repo"
    # No execution of code from a moving, unreviewed branch.
    expected_sha=1fdff1b1c17feb21332c83bce66bb262788eb370
    [[ "$(git -C "$workdir/repo" rev-parse HEAD)" == "$expected_sha" ]] || {
      echo "Pinned Yousty source revision changed; manual review required" >&2
      exit 65
    }
    cd "$workdir/repo"
    timeout 120s node --test \
      tests/yousty-landing-feed.test.mjs \
      tests/landing-unfiltered.test.mjs
    timeout 120s python3 -m unittest \
      crawler.tests.test_yousty_landing_export -v
    echo "remote_tests=passed"
    ;;
  feed-audit)
    timeout 15s python3 /usr/local/lib/careeragency-ops/feed_audit.py
    ;;
  crawler-probe)
    # One robots.txt request and at most one listing-page request.
    # The branch must still match the explicitly reviewed commit.
    workdir="$(mktemp -d /tmp/careeragency-ops-probe.XXXXXXXX)"
    trap 'rm -rf -- "$workdir"' EXIT
    timeout 90s git clone --quiet --depth 1 \
      --branch poc/lehrstellen-crawler-isolated \
      https://github.com/Coco1the8creator7/bewerbungs-agent.git \
      "$workdir/repo"
    expected_sha=1fdff1b1c17feb21332c83bce66bb262788eb370
    [[ "$(git -C "$workdir/repo" rev-parse HEAD)" == "$expected_sha" ]] || {
      echo "Pinned Yousty source revision changed; manual review required" >&2
      exit 65
    }
    cd "$workdir/repo"
    timeout 60s python3 -m crawler.yousty_probe
    ;;
  stage\ [0-9a-f][0-9a-f][0-9a-f]*)
    # Only a full immutable commit SHA can be staged. The helper checks repo provenance.
    target_sha="${SSH_ORIGINAL_COMMAND#stage }"
    if [[ ! "$target_sha" =~ ^[0-9a-f]{40}$ ]]; then
      echo "Denied: stage requires exactly 40 lowercase hexadecimal characters" >&2
      exit 64
    fi
    timeout 180s /usr/local/lib/careeragency-ops/stage_commit.sh "$target_sha"
    ;;
  publish-lehrstellen)
    # The ONLY permitted production write. Root-owned publisher has no arguments,
    # validates 185 source records, preserves live UI and keeps a dated backup.
    timeout 60s sudo -n /usr/local/sbin/careeragency-publish-lehrstellen
    ;;
  release-check)
    # Read-only comparison; never copy files or restart services.
    workdir="$(mktemp -d /tmp/careeragency-ops-release.XXXXXXXX)"
    trap 'rm -rf -- "$workdir"' EXIT
    timeout 90s git clone --quiet --depth 1 --branch main \
      https://github.com/Coco1the8creator7/bewerbungs-agent.git \
      "$workdir/repo"
    if [[ ! -r /var/www/careeragency/current/index.html ]]; then
      echo "release_check=live_index_unreadable"
      exit 66
    fi
    if cmp -s "$workdir/repo/dashboard/index.html" \
        /var/www/careeragency/current/index.html; then
      echo "release_check=live_index_matches_main"
    else
      echo "release_check=live_index_differs_from_main"
      exit 2
    fi
    ;;
  *)
    echo "Denied: SSH command is not on the Career.Agency allowlist." >&2
    exit 64
    ;;
esac
