{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bewerbungs-agent/job.schema.json",
  "title": "Bewerbungs-Agent: Inserat v0.1.0",
  "description": "Ein standardisiertes Inserat aus einer E-Mail oder Stellenplattform. Null bedeutet: nicht sicher bekannt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source",
    "title",
    "company",
    "location",
    "url",
    "categories",
    "first_seen_at",
    "provenance",
    "processing"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stabile ID: quellenbasierte Stellen-ID oder Hash der normalisierten Original-URL."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "z. B. jobs.ch, publicjobs.ch, ewz oder energie360.ch"
    },
    "source_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "company": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ],
      "description": "Arbeitsort im Inserat; keine behauptete Pendelzeit."
    },
    "remote_mode": {
      "enum": [
        "on_site",
        "hybrid",
        "remote",
        "unknown"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "Möglichst kanonische Original-Inserat-URL ohne Trackingparameter."
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "salary_chf_year_min": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "salary_chf_year_max": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "salary_kind": {
      "enum": [
        "explicit",
        "estimated",
        "unknown"
      ],
      "description": "Nie geschätzte Gehälter als inserierte Gehälter ausgeben."
    },
    "workload_pct_min": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "workload_pct_max": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "contract_type": {
      "enum": [
        "permanent",
        "fixed_term",
        "temporary",
        "unknown"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_message_id",
        "source_received_at",
        "alert_name"
      ],
      "properties": {
        "source_message_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Gmail-interne Nachrichten-ID (nur lokal speichern)."
        },
        "source_received_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "alert_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "warnings"
      ],
      "properties": {
        "state": {
          "enum": [
            "new",
            "needs_review",
            "processed",
            "excluded"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraction_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "matching": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optionales Ergebnis der späteren Fit-Analyse. Ohne Abschlussstatus und gültigen Score keine Kennzahl anzeigen.",
      "additionalProperties": false,
      "required": [
        "status",
        "score"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "complete",
            "error",
            "not_run"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "Score 0 bis 100. Nur bei status=complete anzeigen."
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ],
          "description": "Nachvollziehbare Begründung des Fit-Scores."
        },
        "evaluated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "score": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "error",
                  "not_run"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggested_score",
        "version",
        "reason_codes",
        "mode",
        "exclusion"
      ],
      "properties": {
        "suggested_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "version": {
          "type": "string"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "const": "suggestion_only"
        },
        "exclusion": {
          "const": false
        }
      }
    },
    "description_source": {
      "enum": [
        "jsonld_jobposting"
      ]
    },
    "url_aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}
